{
  "name": "liftlog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync:strengthlevel": "python3 scripts/sync_strengthlevel_assets.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:rls": "vitest run --config vitest.rls.config.js",
    "test:rls:watch": "vitest --config vitest.rls.config.js",
    "test:delete-account": "vitest run --config vitest.rls.config.js e2e/delete-account.test.js",
    "load:seed": "node load/seed-users.mjs",
    "load:smoke": "node load/run-load.mjs --profile=smoke",
    "load:baseline": "node load/run-load.mjs --profile=baseline",
    "load:comprehensive": "node load/run-load.mjs --profile=comprehensive",
    "load:spike": "node load/run-load.mjs --profile=spike",
    "load:cleanup": "node load/cleanup.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
